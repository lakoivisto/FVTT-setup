# AWS config for S3 backup sync — credentials come from ~/.aws (mounted read-only into the container)
AWS_DEFAULT_REGION=eu-north-1
# AWS_PROFILE=default
FVTT_BACKUP_BUCKET=fvtt-foundrydata-backup

# S3 asset storage credentials (same IAM user as ansible/group_vars/webservers/secrets.yml)
FVTT_S3_ACCESS_KEY_ID=AKIA...
FVTT_S3_SECRET_ACCESS_KEY=...
