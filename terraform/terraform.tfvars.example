# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored and should never be committed.

# Your public IP in CIDR notation, used to restrict SSH/FoundryVTT access.
# Get it with: curl -s ifconfig.me
whitelist = "1.2.3.4/32"

# Optional overrides (defaults shown):
# aws_region          = "eu-north-1"
# instance_type       = "t3.micro"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
