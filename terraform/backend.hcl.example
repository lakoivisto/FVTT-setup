# Copy this file to backend.hcl and fill in your own values.
# backend.hcl is gitignored and should never be committed.
#
# Use it with: terraform init -backend-config=backend.hcl
#
# The S3 bucket must exist before running `terraform init` — create it
# (with versioning enabled) once, e.g.:
#   aws s3api create-bucket --bucket your-terraform-state-bucket \
#     --region eu-north-1 --create-bucket-configuration LocationConstraint=eu-north-1
#   aws s3api put-bucket-versioning --bucket your-terraform-state-bucket \
#     --versioning-configuration Status=Enabled

bucket = "your-terraform-state-bucket"
key    = "fvtt/terraform.tfstate"
region = "eu-north-1"

# Native S3 state locking (Terraform >= 1.10) — no DynamoDB table needed
use_lockfile = true
